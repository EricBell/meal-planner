# Meal Planner Environment Variables
# Copy this to .env and fill in your values
# For Dokploy: set these as environment variables in the app configuration

# ===== REQUIRED =====
# Telegram Bot - get from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notion Integration - create at https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=          # Recipes database
NOTION_PANTRY_DATABASE_ID=   # Optional: separate pantry database

# ===== DATABASE =====
# SQLite (default, persisted via volume)
DATABASE_URL=sqlite:///./data/meal_planner.db

# PostgreSQL (alternative for production)
# DATABASE_URL=postgresql://user:pass@host:5432/meal_planner

# ===== SCHEDULER =====
# Morning delivery time (24-hour format)
MORNING_DELIVERY_HOUR=8
MORNING_DELIVERY_MINUTE=0

# Weekly Notion harvest
WEEKLY_HARVEST_DAY=sunday
WEEKLY_HARVEST_HOUR=10

# ===== MEAL PLANNING =====
# Comma-separated list of allowed entree types
# Options: beef, pork, chicken, haddock, salmon, shrimp, tofu, eggs, ground_beef, ground_turkey
DEFAULT_ENTREES=beef,pork,chicken,haddock,salmon,shrimp,tofu,eggs,ground_beef,ground_turkey

# Days to plan ahead
DAYS_TO_PLAN=7

# ===== LOGGING =====
LOG_LEVEL=INFO